generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee?
  notification Notification[]
}

model Employee {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  phone       String?
  gender      String?
  birthDate   DateTime?
  fullName    String?
  governorate Governorate?
  jobTitle    JobTitle?
  bio         String?
  cvUrl       String?
  educations  Json?     @db.JsonB
  experiences Json?     @db.JsonB
  location    String?
  carOwnership CarOwnership?
  specialization String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches JobMatch[] @relation("employee_matches")
}

model Company {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  companyName   String
  sector        String
  address       String
  phone         String
  fullname      String
  governorate   String
  jobTitle      JobTitle
  secretCode    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs         Job[]
  secretCodes  SecretCode[]
  notification Notification[]
}

model Job {
  id              Int       @id @default(autoincrement())
  companyId       Int
  jobTitle        String
  description     String
  requirements    String
  governorate     String
  specialization  String
  salary          String
   contactEmail String
      contactPhone String
  lineOfWork      String?
  gender          String?
  carOwnership    String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobMatches JobMatch[]
}

model JobMatch {
  id         Int      @id @default(autoincrement())
  jobId      Int
  employeeId Int
  matchRate  Float
  createdAt  DateTime @default(now())

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Employee @relation("employee_matches", fields: [employeeId], references: [id], onDelete: Cascade)
}

model SecretCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  companyId   Int?
  createdById Int
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  usageCount  Int       @default(0)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  companyId Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyRequest {
  id            Int      @id @default(autoincrement())
  email         String
  companyName   String
  sector        String
  address       String
  phone         String
  fullname      String
  governorate   String
  jobTitle      JobTitle
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

